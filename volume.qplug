function GetPins(props)
  local ch_count = props["Channel Count"].Value
  local pins = {}

  for i = 1, ch_count do
    table.insert(pins,
    {
      Name = string.format("Input %i", i),
      Direction = "input",
    })
    table.insert(pins,
    {
      Name = string.format("Output %i", i),
      Direction = "output",
    })
  end
  return pins
end

function GetComponents(props)
  local ch_count = props["Channel Count"].Value
  comps = {
      {
        Name = "internal_gain",
        Type =  "gain",
        Properties =
        {
          multi_channel_type = 3, 
          multi_channel_count = ch_count, 
        }
      },
    }

  return comps
end

function GetWiring(props)
  local ch_count = props["Channel Count"].Value
  local wiring = {}

  for i = 1, ch_count do
    table.insert(wiring, { string.format("Input %i", i) , string.format("internal_gain Input Channel %i", i) })
    table.insert(wiring, { string.format("internal_gain Output Channel %i", i) , string.format("Output %i", i) })
  end

  return wiring
end

--Runtime Code
if Controls then

  local minGain = -100
  local maxGain = 10

  local alpha = 18.685
  local beta = 1


  function funcCheckMuteState()
    print('Checking Mute State')
    local state = (Controls.gain.Position == 0) or (Controls.volume.Position == 0)
    Controls.mute.Boolean = state
    internal_gain.mute.Boolean = state
    collectgarbage()
  end 

  function funcCalculateGain()
    print('Calculating Gain')
  
    local normalised = Controls.volume.Value / 100
  
  
    local mappedDb = minGain + (maxGain - minGain) * (math.log10(alpha * normalised + beta) / math.log10(alpha + beta))

    Controls.gain.Value = mappedDb
    
    funcCheckMuteState()

    internal_gain.gain.Value = Controls.gain.Value
    savedVolume = Controls.volume.Position 
    savedGain   = Controls.gain.Position
  end 
  
  function funcCalculateVolume()
    print('Calculating Volume')


    if Controls.gain.Value < minGain then Controls.gain.Value = minGain end
    if Controls.gain.Value > maxGain then Controls.gain.Value = maxGain end

    local t = (Controls.gain.Value - minGain) / (maxGain - minGain)
    local normalised = (10^ (t * math.log10(alpha + beta)) - beta) / alpha
    local percentage = normalised * 100

    Controls.volume.Value = percentage
  
    funcCheckMuteState()

    internal_gain.gain.Value = Controls.gain.Value
    savedVolume = Controls.volume.Position 
    savedGain   = Controls.gain.Position
  end 
  
  
  
  function funcAutoMute()
  
    if Controls.mute.Boolean then 
      savedGain   = Controls.gain.Position
      savedVolume = Controls.volume.Position
      Controls.gain.Position   = 0
      Controls.volume.Position = 0
    else 
      Controls.gain.Position   = savedGain
      Controls.volume.Position = savedVolume
    end 
    internal_gain.gain.Value = Controls.gain.Value
  end 
  
 function funcInit()
    savedVolume = Controls.volume.Position 
    savedGain   = Controls.gain.Position

    internal_gain.gain.Value    = Controls.gain.Value
    internal_gain.mute.Boolean  = Controls.mute.Boolean
    funcCalculateVolume() 
  end 
  
  Controls.gain.EventHandler   = funcCalculateVolume
  Controls.volume.EventHandler = funcCalculateGain
  Controls.mute.EventHandler   = funcAutoMute
  
  funcInit()

end