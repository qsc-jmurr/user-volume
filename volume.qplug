function GetColor()
  return { 191, 226, 249 }
end

function GetProperties()
  props = {
    { 
      Name = "Channel Count",
      Type = "integer",
      Min = 1,
      Max = 128,
      Value = 1,
    },
  }
  return props
end
function RectifyProperties(props)
   	props.plugin_show_debug.IsHidden = false
  return props
end


